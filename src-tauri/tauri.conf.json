{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Story Archive",
  "version": "0.2.2",
  "identifier": "com.dieuminhs.local-story-archive",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": []
  },
  "bundle": {
    "active": true,
    "resources": ["bin/*"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}

